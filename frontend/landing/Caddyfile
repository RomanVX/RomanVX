# VPS в РФ (RuVDS, Королёв, 45.141.101.104): сайт фулфилмента + проход к дашбордам.
#
# Render из РФ заблокирован по IP, а через другие IP Cloudflare большие ответы
# режутся (~20 КБ). Поэтому в Render ходим через локальный туннель Xray
# (127.0.0.1:10443 → VPN → 216.24.57.16:443), конфиг — scripts/vps/xray_from_link.py.
# TLS до Render сквозной: Caddy сам делает рукопожатие с нужным SNI.

(render_wb) {
    reverse_proxy 127.0.0.1:10443 {
        transport http {
            tls
            tls_server_name wb-dashboard-6wxf.onrender.com
        }
        header_up Host wb-dashboard-6wxf.onrender.com
    }
}
(render_fk) {
    reverse_proxy 127.0.0.1:10443 {
        transport http {
            tls
            tls_server_name fk-dashboard.onrender.com
        }
        header_up Host fk-dashboard.onrender.com
    }
}
(render_mpfit) {
    reverse_proxy 127.0.0.1:10443 {
        transport http {
            tls
            tls_server_name mpfit-dashboard.onrender.com
        }
        header_up Host mpfit-dashboard.onrender.com
    }
}
(render_tl) {
    reverse_proxy 127.0.0.1:10443 {
        transport http {
            tls
            tls_server_name tl-dashboard-huqh.onrender.com
        }
        header_up Host tl-dashboard-huqh.onrender.com
    }
}

marketpartners.ru, www.marketpartners.ru {
    encode gzip
    # «Упаковка КИЗ» склада: marketpartners.ru/kiz → сервис МПФИТ на Render.
    # Отдельные handle с одним путём — Caddy ставит их раньше общего /api/*.
    handle /kiz {
        import render_mpfit
    }
    # срок годности по КИЗ: публичный сервис «Честного знака» закрыт для
    # зарубежных IP (451) — ходим к нему с этого российского VPS напрямую
    handle /crpt/* {
        uri strip_prefix /crpt
        reverse_proxy https://mobile.api.crpt.ru {
            header_up Host mobile.api.crpt.ru
            header_up -Origin
            header_up -Referer
            header_up -Cookie
        }
    }
    handle /api/kiz/* {
        import render_mpfit
    }
    handle /static/kiz-parse.js {
        import render_mpfit
    }
    handle /static/bwip-js-min.js {
        import render_mpfit
    }
    # заявки с сайта: /api/landing/* → бэкенд дашборда Biomed
    handle /api/* {
        import render_wb
    }
    handle {
        root * /var/www/marketpartners
        file_server
    }
}
biomed.marketpartners.ru {
    import render_wb
}
fk.marketpartners.ru {
    import render_fk
}
tl.marketpartners.ru {
    import render_tl
}
