WB_API_KEY=your_wildberries_api_key_here

# ── Уведомления о заявках с лендинга (/api/lead) ────────────────────────────
# Заявки всегда пишутся в backend/data/leads.jsonl; чтобы получать их
# в Telegram и/или на почту, заполните переменные ниже (можно оба канала).

# Telegram: создайте бота у @BotFather, узнайте chat_id у @userinfobot
#LEAD_TG_BOT_TOKEN=123456:ABC-DEF...
#LEAD_TG_CHAT_ID=123456789

# Почта по SMTP (порт 465 — SSL, другой — STARTTLS)
#LEAD_SMTP_HOST=smtp.yandex.ru
#LEAD_SMTP_PORT=465
#LEAD_SMTP_USER=noreply@marketpartners.ru
#LEAD_SMTP_PASS=app_password_here
#LEAD_EMAIL_TO=hello@marketpartners.ru
#LEAD_EMAIL_FROM=noreply@marketpartners.ru
